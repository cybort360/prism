{
  "name": "prism-mera-bridge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Builds the offscreen WebView bundle that runs the official @category-labs/mera library for Prism's native iOS app.",
  "scripts": {
    "build": "esbuild src/bridge.js --bundle --format=iife --platform=browser --outfile=../../Prism/Resources/MeraWeb/mera-bridge.js",
    "watch": "npm run build -- --watch"
  },
  "dependencies": {
    "@category-labs/mera": "^0.2.0",
    "viem": "^2"
  },
  "devDependencies": {
    "esbuild": "^0.24"
  }
}
