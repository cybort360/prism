PORT=8787
NODE_ENV=development
STORE_PATH=./data/store.json

# Backend secrets (production must replace all of these)
SESSION_SECRET=replace-with-32-random-bytes
RESOLVER_PEPPER=replace-with-32-random-bytes
DATA_ENCRYPTION_KEY=replace-with-64-hex-chars
SERVICE_KEY_ENCRYPTION_KEY=replace-with-another-64-hex-key

# Limits (atomic units, USDC has 6 decimals): 10,000 USDC payment / 1,000 USDC claim
MAX_PAYMENT_ATOMIC=10000000000
MAX_CLAIM_ATOMIC=1000000000

# OTP (Twilio Verify). Without these the backend uses an explicit dev OTP and never claims a real SMS was sent.
DEV_OTP_CODE=123456
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Monad network: testnet chainId 10143, mainnet chainId 143 (gas token MON)
MONAD_CHAIN_ID=10143
# Production RPC is Alchemy's Monad endpoint (https://monad-testnet.g.alchemy.com/v2/<key>
# or https://monad-mainnet.g.alchemy.com/v2/<key>); falls back to the public node.
MONAD_RPC_URL=https://testnet-rpc.monad.xyz/

# Circle USDC. Auto-selected from MONAD_CHAIN_ID. Set only for a custom deployment. The backend
# checks the on-chain EIP-712 domain separator before relaying and fails closed on any drift.
USDC_ADDRESS=

# Prism on-chain surface (deploy with contracts/script/Deploy.s.sol)
PRISM_PAYMENT_ROUTER=
PRISM_CLAIM_VAULT=

# MON-funded relayer that submits gasless USDC ERC-3009 transfers.
# Production alternative: Alchemy Gas Manager sponsorship.
RELAYER_PRIVATE_KEY=

# Isolated secp256k1 key that authorizes pre-user claim collection (KMS/HSM in production).
CLAIM_AUTHORIZER_PRIVATE_KEY=

# Envio HyperIndex GraphQL endpoint for the reconciled activity/indexing layer.
ENVIO_GRAPHQL_URL=

# Alchemy Address-Activity webhook signing key. The POST /v1/webhooks/alchemy handler verifies the
# X-Alchemy-Signature HMAC over the raw body; without this key the endpoint rejects every webhook.
ALCHEMY_WEBHOOK_SIGNING_KEY=

# Developer/judge Proof surface (GET /v1/proof/:id, GET /v1/metrics). Enabled outside production
# automatically; in production set PROOF_ENABLED=true to expose it. Never shown to normal consumers.
PROOF_ENABLED=

# iOS-side (Info.plist key, NOT read here): PRISM_FAUCET_URL powers the DEBUG-only Add-money faucet.
