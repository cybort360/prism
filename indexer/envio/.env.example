# The USDC.Transfer handler tags transfers that touch the router/vault as VaultTransfer, so it needs
# to know their addresses. These match the DEMO environment (mock-pinned router + MockUSDC) in
# backend/.env. Copy to .env (gitignored) or export before `envio dev`.
PRISM_PAYMENT_ROUTER=0x80e00BF20F027C9BF69926280c4A18Df1bDd06e0
PRISM_CLAIM_VAULT=0xBe3D0b0404674e032D153182a58b1901D1d6Eae3
